{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/logo-gpib.png",
      "dest": "/logo-gpib.png"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
